{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts"
  },
  "dependencies": {
    "@clerk/backend": "^1.20.0",
    "@hono/clerk-auth": "^2.0.0",
    "@hono/node-server": "^2.1.8",
    "@neondatabase/serverless": "^0.10.4",
    "@types/ws": "^8.18.1",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.13.19",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
